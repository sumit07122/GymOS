{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "FIXIA GymOS",
  "short_name": "GymOS",
  "description": "Commercial Fitness Business Operating System & Member Portal",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F8FAFC",
  "theme_color": "#0B6B4F",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "fitness",
    "business",
    "productivity"
  ]
}

