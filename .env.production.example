# ==============================================================================
# FIXIA GymOS — Production Environment Configuration (.env.production)
# ==============================================================================
# IMPORTANT:
# - NEVER commit production secrets, private keys, or passwords to source control.
# - Configure these environment variables in your Vercel Project Settings (Environment Variables)
#   or your production container orchestrator (e.g. AWS ECS, Doppler, HashiCorp Vault).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string with PgBouncer enabled for serverless lambda scaling
DATABASE_URL="postgresql://neondb_owner:[NEON_SECURE_PASSWORD]@[NEON_REGION]-pooler.neon.tech/gymos_production?sslmode=require&pgbouncer=true&connection_limit=20"

# DIRECT_URL: Direct non-pooled connection string required for Prisma migrations and DDL execution
DIRECT_URL="postgresql://neondb_owner:[NEON_SECURE_PASSWORD]@[NEON_REGION].neon.tech/gymos_production?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Node runtime environment (must be "production")
NODE_ENV="production"

# Canonical production application domain (HTTPS enforced)
NEXT_PUBLIC_APP_URL="https://gymos.fixia.app"

# Auth.js / NextAuth v5 Session Signing Secret (Generate using: `openssl rand -base64 32`)
AUTH_SECRET="REPLACE_WITH_MINIMUM_32_BYTE_RANDOM_BASE64_STRING"

# Cryptographic QR HMAC-SHA256 Master Seed Secret (Generate using: `openssl rand -hex 32`)
ATTENDANCE_HMAC_SECRET="REPLACE_WITH_MINIMUM_64_CHAR_HEX_SECRET"

# Cron Job Authorization Secret (Bearer token for triggering scheduled maintenance & reminder workers)
CRON_SECRET="REPLACE_WITH_SECURE_CRON_BEARER_TOKEN"

# ------------------------------------------------------------------------------
# 3. AWS S3 & CLOUDFRONT STORAGE (Receipts, Logos, Member Photos, Gallery)
# ------------------------------------------------------------------------------
# S3 Bucket name for private receipts and public gym assets
AWS_S3_BUCKET_NAME="fixia-gymos-production-assets"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA_REPLACE_WITH_PRODUCTION_IAM_KEY_ID"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_PRODUCTION_IAM_SECRET_ACCESS_KEY"

# CloudFront CDN distribution domain for caching public images and assets
NEXT_PUBLIC_CDN_URL="https://assets.gymos.fixia.app"

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS PLATFORM (Meta Graph API)
# ------------------------------------------------------------------------------
# System-level default credentials (used if a gym does not connect their own WhatsApp Business account)
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_PHONE_NUMBER_ID="REPLACE_WITH_META_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="REPLACE_WITH_META_WABA_ID"
WHATSAPP_ACCESS_TOKEN="REPLACE_WITH_SYSTEM_META_PERMANENT_SYSTEM_USER_ACCESS_TOKEN"

# Webhook Verification Token (configured in Meta App Dashboard for status callbacks)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN"
WHATSAPP_WEBHOOK_APP_SECRET="REPLACE_WITH_META_APP_SECRET_FOR_SIGNATURE_VERIFICATION"

# ------------------------------------------------------------------------------
# 5. PLATFORM SUPER ADMIN BOOTSTRAP (Optional for initial environment provisioning)
# ------------------------------------------------------------------------------
# Email address of primary super administrator authorized to access /admin
INITIAL_SUPER_ADMIN_EMAIL="superadmin@fixia.app"
