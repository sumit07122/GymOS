# ==============================================================================
# FIXIA GymOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit .env or live production secrets to version control.
# ==============================================================================

# Neon Serverless PostgreSQL Database URLs
# DATABASE_URL: Pooled connection string (PgBouncer mode, used for application runtime queries)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.c-1.neon.tech/[database]?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct non-pooled connection string (used for schema migrations and DDL operations)
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].c-1.neon.tech/[database]?sslmode=require"

# Auth.js v5 (NextAuth) Session Secret
AUTH_SECRET="your-32-byte-random-secret-placeholder"

# QR Attendance Cryptographic HMAC Secret (Used for signing 60s dynamic QR check-in tokens)
ATTENDANCE_HMAC_SECRET="your-64-byte-secure-hmac-attendance-secret-placeholder"

# Application Environment & Base URL
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

